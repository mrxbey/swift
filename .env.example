# Supabase Configuration
# Copy this file to .env and fill in your actual values
# Never commit .env to version control!

# Your Supabase project URL
# Format: https://xxxxxxxxxxxxx.supabase.co
SUPABASE_URL=https://your-project.supabase.co

# Your Supabase anon/public API key
# Find this in your Supabase project dashboard → Settings → API
# This key is safe to use in client applications (respects RLS)
SUPABASE_ANON_KEY=your_anon_key_here

# Optional: Service role key for admin operations (DO NOT use in client apps)
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
